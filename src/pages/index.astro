---
import Layout from '@/layouts/Layout.astro';
import contentColumn from '@/components/styles/contentColumn';

const BASE_URL = import.meta.env.BASE_URL.replace(/\/$/, ''); // '/web-effects'

const LINKS = [
  { href: `${BASE_URL}/all-gray-but-one`, label: 'All Gray But One' },
  { href: `${BASE_URL}/glass`, label: 'Glass' },
  { href: `${BASE_URL}/grid`, label: 'Grid' },
  { href: `${BASE_URL}/safari`, label: 'Safari' },
  { href: `${BASE_URL}/scroll-animations`, label: 'Scroll Animations' },
  { href: `${BASE_URL}/split-flip-timer`, label: 'Split Flip Timer' },
  { href: `${BASE_URL}/windows-effect`, label: 'Windows Effect' },
];
---

<Layout class:list={['flex', 'flex-col', 'min-h-dvh']}>
  <nav class:list={['border-b', 'border-gray-700', contentColumn()]}>Web Effects</nav>
  <main class:list={['flex-1', 'flex', 'flex-col']}>
    <section class:list={contentColumn()}>
      <ul>
        {
          LINKS.map(({ href, label }) => (
            <li class:list={['underline', 'decoration-transparent', 'hover:decoration-gray-800']}>
              <a href={href}>{label}</a>
            </li>
          ))
        }
      </ul>
    </section>
    <div class:list={['flex-1', contentColumn()]}></div>
  </main>
  <footer class:list={['border-t', 'border-gray-700', contentColumn()]}>Github</footer>
</Layout>
