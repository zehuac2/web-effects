---
import '@/styles/global.css';

interface Props {
  /** Add additional classes to main */
  class?: string;
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>
  <body class={Astro.props.class}>
    <slot />
  </body>
</html>
